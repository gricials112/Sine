<?xml version="1.0" encoding="UTF-8"?>
<!-- Sine App Info.plist。含权限与合规矩阵 (FRD 评审 P0-6)。
     XcodeGen 中以 INFOPLIST_FILE 引用, GENERATE_INFOPLIST_FILE=NO。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 基本信息 (大部分用构建变量注入, 便于 CI) -->
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>Sine</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- App Store 分类 -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <!-- 出口合规: 仅使用 Apple 提供的标准/豁免加密 (本 App 无自有加密、不联网) -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- 相册读取 (从相册导入视频/音频, UC-01) -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>用于从相册导入视频或音频以进行本地音轨分离。所有处理均在本机完成，不会上传任何文件。</string>
    <!-- 相册写入 (导出到相册, UC-06) -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>用于将分离或混音后的音频保存到相册。</string>

    <!-- 接收微信等 App 的“用其他应用打开” (UC-01 微信分享导入) -->
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Audio</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.audio</string>
                <string>public.movie</string>
                <string>public.mpeg-4</string>
                <string>public.mp3</string>
            </array>
        </dict>
    </array>

    <!-- 后台音频: 调音台在后台继续播放 (真实使用, 符合审核要求) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
